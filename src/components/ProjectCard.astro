---
import type { ProjectCard } from '../types';
import { formatTemplate, getContent } from '../data/content';
import IconGitHub from './icons/IconGitHub.astro';
import IconLink from './icons/IconLink.astro';

interface Props {
  project: ProjectCard;
  showStars?: boolean;
}

const { project, showStars = false } = Astro.props;
const content = getContent();
const classes = ['proj-card'];
if (project.wide) classes.push('wide');
if (project.maroon) classes.push('maroon');

const showGitHubLink = project.source === 'github';
const externalLink = project.homepage || (project.source === 'manual' ? project.url : undefined);
const showExternalLink = Boolean(externalLink) && (!showGitHubLink || externalLink !== project.url);
---

<div class:list={classes}>
  <div class="proj-top">
    <div class="proj-name"><span class="br">[</span>{project.name}<span class="br">]</span></div>
    {(showGitHubLink || showExternalLink) && (
      <div class="proj-links">
        {showGitHubLink && (
          <a
            class="proj-card-link"
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={formatTemplate(content.projects.ariaLabels.viewOnGitHub, { name: project.name })}
          >
            <IconGitHub />
          </a>
        )}
        {showExternalLink && (
          <a
            class="proj-card-link"
            href={externalLink}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={formatTemplate(content.projects.ariaLabels.visit, { name: project.name })}
          >
            <IconLink />
          </a>
        )}
      </div>
    )}
  </div>
  <div class="proj-desc">{project.description}</div>
  {project.tags.length > 0 && (
    <div class="proj-meta">
      <div class="proj-tags">
        {project.tags.map((tag) => <span class="chip">{tag}</span>)}
      </div>
    </div>
  )}
  {showStars && project.note && <div class="proj-note">{project.note}</div>}
</div>
