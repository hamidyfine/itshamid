---
import { theme } from '../config/theme';
import { getContent } from '../data/content';
import { buildSeo } from '../lib/seo';
import ContactPanel from '../components/ContactPanel.astro';
import type { SeoProps } from '../types';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props extends SeoProps {
  activeNav?: string;
  bodyClass?: string;
}

const content = getContent();
const { activeNav, bodyClass, ...seoProps } = Astro.props;
const seo = buildSeo(content, seoProps);
const tone = theme.tones[theme.activeTone];
---

<!doctype html>
<html lang={content.site.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {seo.noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={seo.canonical} />
    <meta name="author" content={seo.author} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content={seo.type} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:site_name" content={seo.siteName} />
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:image" content={seo.image} />
    {seo.publishedTime && <meta property="article:published_time" content={seo.publishedTime} />}
    {seo.modifiedTime && <meta property="article:modified_time" content={seo.modifiedTime} />}
    {seo.tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={seo.twitter} />
    <meta name="twitter:creator" content={seo.twitter} />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />

    <link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={content.site.shortName} />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={theme.fonts.googleUrl} rel="stylesheet" />

    <style is:global define:vars={{
      cream: tone[0],
      cream2: tone[1],
      border: tone[2],
      maroon: tone[3],
      white: theme.colors.white,
      ink: theme.colors.ink,
      ink2: theme.colors.ink2,
      ink3: theme.colors.ink3,
      orange: theme.colors.accent,
      'orange-hover': theme.colors.accentHover,
      'orange-dim': theme.colors.accentDim,
      'orange-bg': theme.colors.accentBg,
      success: theme.colors.success,
      font: theme.fonts.sans,
      mono: theme.fonts.mono,
      'nav-h': theme.layout.navHeight,
      max: theme.layout.maxWidth,
      pad: theme.layout.padding,
      'pad-mobile': theme.layout.paddingMobile,
    }}></style>
  </head>
  <body class={bodyClass}>
    <Nav active={activeNav} />
    <slot />
    
    <section class="band" id="contact" style="padding-top:40px; padding-bottom:56px;">
      <div class="inner">
        <div class="maroon-band">
          <!-- <div class="maroon-label">{content.contact.label}</div> -->
          <div class="contact-grid">
            <div>
              <h2 class="contact-title">{content.contact.title[0]} <em>{content.contact.title[1]}</em> {content.contact.title[2]}</h2>
              <!-- <p class="contact-desc">{content.contact.description}</p> -->
              <!-- <div class="info-panel">
                {content.contact.info.map((item) => (
                  <div class="info-item">
                    <div class="info-label">{item.label}</div>
                    <div class="info-value">
                      {item.status && <span class="idot"></span>}
                      {item.value}
                    </div>
                  </div>
                ))}
              </div> -->
            </div>
            <ContactPanel
              scheduleMeeting={content.contact.scheduleMeeting}
              links={content.contact.links}
            />
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </body>
</html>
