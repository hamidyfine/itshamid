---
import type { ContactLink } from '../types';
import ContactIcon from './ContactIcon.astro';

interface Props {
  scheduleMeeting: { label: string; href: string };
  links: ContactLink[];
}

const { scheduleMeeting, links } = Astro.props;
---

<div class="contact-panel">
  <a
    class="btn btn-orange contact-schedule"
    href={scheduleMeeting.href}
    target="_blank"
    rel="noopener noreferrer"
  >
    <span class="contact-schedule-label">{scheduleMeeting.label}</span>
    <svg class="contact-schedule-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
      <line x1="16" y1="2" x2="16" y2="6" />
      <line x1="8" y1="2" x2="8" y2="6" />
      <line x1="3" y1="10" x2="21" y2="10" />
    </svg>
  </a>

  <div class="contact-social">
    {links.map((link) => (
      <a
        class="contact-social-link"
        href={link.href}
        target={link.href.startsWith('http') ? '_blank' : undefined}
        rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        aria-label={`${link.platform}: ${link.handle}`}
      >
        <ContactIcon name={link.icon} />
      </a>
    ))}
  </div>
</div>
